# Copy this to server/.env on the VPS. Do NOT commit the real .env.

# ── Required ──────────────────────────────────────────────────────────────

# A long random string used to sign MEROS JWTs. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# If this leaks, ALL existing sessions can be forged — rotate immediately.
JWT_SECRET=replace-me-with-a-48-byte-random-string

# Google OAuth client ID — same one the frontend renders the GIS button with.
# Get from https://console.cloud.google.com → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# ── Optional (have sensible defaults) ─────────────────────────────────────

# Where the SQLite DB lives on disk. Default is fine for the VPS layout
# described in DEPLOY.md; override in dev to keep test data separate.
DB_PATH=/var/lib/meros/meros.db

# Port the Express server listens on. nginx proxies /api/* here.
PORT=3000

# Set to "1" to allow CORS from any origin (dev). Production runs same-origin
# behind nginx so CORS isn't needed.
ALLOW_ANY_CORS=0
